SPACE_STATION_VERSION=1.0.0

# The published web bundle uses these localhost origins.
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
PREVIEW_ORIGIN=http://localhost:4000

GITHUB_API_URL=https://api.github.com
GITHUB_OAUTH_URL=https://github.com
GITHUB_OAUTH_API_URL=https://github.com
GITHUB_FIXTURE_MODE=0
GITHUB_APP_ID=
# Paste the PEM with literal \n separators instead of physical newlines.
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public HTTPS endpoint ending in /v1/github/webhooks when using a tunnel.
GITHUB_WEBHOOK_PUBLIC_URL=
GITHUB_WEBHOOK_SECRET=

AUTH_SESSION_KEYS=
AUTH_COOKIE_SECURE=false
PREVIEW_SIGNING_SECRET=
AUTH_MODE=github
