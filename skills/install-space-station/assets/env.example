# Exact published GHCR release used by compose.production.yml (do not use latest).
SPACE_STATION_VERSION=1.0.1

# Runtime values below stay in the consumer's local .env and are never built into the image.
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
PREVIEW_ORIGIN=http://localhost:4000
GITHUB_API_URL=https://api.github.com
GITHUB_OAUTH_URL=https://github.com
GITHUB_OAUTH_API_URL=https://github.com
GITHUB_FIXTURE_MODE=0

# Use github_app for the legacy App-only deployment, both values for side-by-side login,
# or personal_access_token for a PAT-only deployment.
GITHUB_AUTH_METHODS=github_app
# Optional server-only configured PAT login. Keep this value in the API environment only and
# enable the public button explicitly with GITHUB_CONFIGURED_PAT_LOGIN=true. Browser-entered
# PATs do not belong here. Never put a PAT in a VITE_* variable.
# GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_CONFIGURED_PAT_LOGIN=false

# Required only when github_app is included in GITHUB_AUTH_METHODS.
GITHUB_APP_ID=
# Paste the PEM with literal \n separators instead of physical newlines.
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public HTTPS endpoint: https://YOUR-TUNNEL.example/v1/github/webhooks
GITHUB_WEBHOOK_PUBLIC_URL=
GITHUB_WEBHOOK_SECRET=

AUTH_SESSION_KEYS={"activeKid":"local-v1","keys":{"local-v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"}}
AUTH_COOKIE_SECURE=false
PREVIEW_SIGNING_SECRET=development-preview-secret-32-bytes
AUTH_MODE=github
